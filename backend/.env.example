PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_dlc_crud
DB_USER=root
DB_PASSWORD=
# Set DB_SSL=true when connecting to TiDB Cloud / PlanetScale / Aiven / any managed MySQL that requires TLS
DB_SSL=false

JWT_SECRET=
JWT_EXPIRES_IN=7d

# SSLCommerz (Bangladesh payment gateway)
# Sandbox defaults: testbox / qwerty — replace with production credentials for live
SSLCZ_STORE_ID=testbox
SSLCZ_STORE_PASSWORD=qwerty
SSLCZ_IS_LIVE=false
FRONTEND_URL=http://localhost:3001
BACKEND_URL=http://localhost:3000

# Cloudinary (optional — required on hosts with ephemeral disk like Render free)
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
# When set, uploads stream to Cloudinary instead of the local uploads/ dir.
CLOUDINARY_URL=
